{
  "name": "dsh-plugin-quote-comment",
  "version": "0.2.0",
  "description": "Ask for a comment before inserting a quoted selection, as one block — in chat and in file previews.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/hanfang5057/dsh-plugin-quote-comment.git"
  },
  "homepage": "https://gitee.com/hanfang5057/dsh-plugin-quote-comment",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quote",
    "comment"
  ],
  "engines": {
    "dsh": "^0.2.2-0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
